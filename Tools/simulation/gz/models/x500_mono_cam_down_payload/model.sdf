<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_mono_cam_down'>
    <self_collide>false</self_collide>
    <include merge='true'>
      <uri>x500</uri>
    </include>


<!-- ===================== DUMMY BLUE (ileride) ===================== -->
<link name="payload_blue_link">

  <!-- ================== BLUE (ileride) ================== -->
  <pose relative_to="base_link">0  0.19 -0.32 0 0 0</pose>
  
  <gravity>false</gravity>

  <inertial>
    <mass>0.001</mass>
    <inertia>
      <ixx>1e-6</ixx> <iyy>1e-6</iyy> <izz>1e-6</izz>
      <ixy>0</ixy> <ixz>0</ixz> <iyz>0</iyz>
    </inertia>
  </inertial>

  <visual name="payload_blue_visual">
    <geometry>
      <cylinder>
        <radius>0.15</radius>
        <length>0.05</length>
      </cylinder>
    </geometry>
    <material>
      <diffuse>0 0 1 1</diffuse>
      <ambient>0 0 1 1</ambient>
    </material>
  </visual>
</link>

<joint name="payload_blue_dummy_joint" type="fixed">
  <parent>base_link</parent>
  <child>payload_blue_link</child>
</joint>


<!-- ===================== DUMMY RED (geride) ===================== -->
<link name="payload_red_link">

  <!-- ================== RED (geride) ================== -->
  <pose relative_to="base_link">0 -0.19 -0.32 0 0 0</pose>
  
  <gravity>false</gravity>

  <inertial>
    <mass>0.001</mass>
    <inertia>
      <ixx>1e-6</ixx> <iyy>1e-6</iyy> <izz>1e-6</izz>
      <ixy>0</ixy> <ixz>0</ixz> <iyz>0</iyz>
    </inertia>
  </inertial>

  <visual name="payload_red_visual">
    <geometry>
      <cylinder>
        <radius>0.15</radius>
        <length>0.05</length>
      </cylinder>
    </geometry>
    <material>
      <diffuse>1 0 0 1</diffuse>
      <ambient>1 0 0 1</ambient>
    </material>
  </visual>
</link>

<joint name="payload_red_dummy_joint" type="fixed">
  <parent>base_link</parent>
  <child>payload_red_link</child>
</joint>



<plugin filename="libPayloadDropSystem.so" name="payload::PayloadDropSystem">
  <topic>/payload_drop</topic>
  <world_name>default</world_name>

  <uav_model>x500_mono_cam_down_0</uav_model>
  <uav_link>base_link</uav_link>

  <dummy_payload_link_red>payload_red_link</dummy_payload_link_red>
  <offset_red_x>0</offset_red_x>
  <offset_red_y>0</offset_red_y>
  <offset_red_z>-0.55</offset_red_z>

  <dummy_payload_link_blue>payload_blue_link</dummy_payload_link_blue>
  <offset_blue_x>0</offset_blue_x>
  <offset_blue_y>0</offset_blue_y>
  <offset_blue_z>-0.50</offset_blue_z>

  <spawn_name_prefix>payload_drop_</spawn_name_prefix>

  <!-- opsiyonel: fiziksel ölçüler -->
  <radius>0.15</radius>
  <length>0.05</length>
  <mass>0.3</mass>
</plugin>




    <include merge='true'>
      <uri>model://mono_cam</uri>
      <pose>0.35 0 .05 0 1.5707 0</pose>
      <name>mono_cam</name>
    </include>
    <joint name="CameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
      <pose relative_to="base_link">0 0 0 0 1.5707 0</pose>
    </joint>
  </model>
</sdf>
